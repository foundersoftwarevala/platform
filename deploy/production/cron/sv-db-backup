# Encrypted, off-site copy of the existing logical database export.
# The export is table-by-table, not an atomic PostgreSQL snapshot.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root /usr/local/bin/sv-db-backup-r2.sh >> /var/log/sv-db-backup.log 2>&1
