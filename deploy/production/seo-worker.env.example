# Install as root-owned mode 0600 at /etc/softwarevala/seo-worker.env.
# Generate a fresh high-entropy token for both the app process and worker service.
SEO_MARKETPLACE_WORKER_TOKEN=<64-hex-character-secret>
SEO_MARKETPLACE_WORKER_URL=http://127.0.0.1:3000/api/marketplace-product-country-seo-worker
