# Install as /etc/softwarevala/seo-gate.env, readable only by root.
SEO_GATE_MAX_DROP_PERCENT=2

# Optional root mailbox alerts; enable only with a verified local-only MTA.
# SEO_GATE_ALERT_LOCAL_MAIL=1

# Optional authorized HTTPS endpoint; verify with sv-seo-gate.sh --test-alert.
# Without one, syslog and the persistent local failure record remain active.
# SEO_GATE_ALERT_WEBHOOK='https://your-authorized-endpoint'
