# Install as /etc/softwarevala/db-backup-r2.env, owned by root, mode 0600.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=replace-with-private-backup-bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# age public recipient only; keep its matching private identity off the VPS.
R2_BACKUP_AGE_RECIPIENT=age1replacewithpublicrecipient
