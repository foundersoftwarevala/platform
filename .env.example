# Software Vala platform — environment template.
#
# Copy to .env and fill in. NO VALUES BELONG IN THIS FILE OR IN GIT: it lists
# only the names the code reads, so a deployment can be reproduced. Secrets
# live in the server's own .env (which .gitignore excludes) and are rotated
# there, never here.
#
# Names were taken from the code (process.env / import.meta.env / os.environ)
# and from the running production process.

# --- Supabase (required) -----------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=
# Browser build (Vite) — publishable values only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_USE_DEV_DB=

# --- Site / runtime ----------------------------------------------------------
NODE_ENV=production
SITE_URL=
APP_BASE_URL=
PORT=
NITRO_PORT=
NITRO_PRESET=
# Guards the /api/internal/* endpoints.
INTERNAL_API_TOKEN=
DEPLOY_REPO_DIR=

# --- Payments (PayU; unset means online payment is refused, never faked) -----
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=
PAYU_PAYMENT_ENDPOINT=
PAYU_VERIFY_ENDPOINT=
# Exchange-rate source used to convert an order total before handover.
FX_API_URL=

# --- Translation engine (client side of services/translation-engine) ---------
TRANSLATE_PROVIDER_URL=
TRANSLATE_PROVIDER_TOKEN=
TRANSLATE_PROVIDER_TIMEOUT_MS=
TRANSLATION_PROVIDER_ORDER=
TRANSLATION_ALLOW_EXTERNAL=
I18N_JOB_WORKER=
I18N_JOB_MAX_LOAD=

# --- Translation engine service (services/translation-engine) ----------------
SVT_URL=
SVT_TOKEN=
SVT_MODEL_DIR=
SVT_DETECTOR_PATH=
SVT_ROUTING_PATH=
SVT_LIBRETRANSLATE_URL=
SVT_HTTP_TIMEOUT=
SVT_MODE=
SVT_PRELOAD=
SVT_ALLOW_NO_TOKEN=

# --- Mail --------------------------------------------------------------------
MAIL_FROM=
LEADS_NOTIFY_EMAIL=
SMTP_RELAY_URL=
SMTP_RELAY_TOKEN=
RESEND_API_KEY=

# --- AI providers (optional; used by the AI API registry) --------------------
AI_API_CREDENTIAL_ENCRYPTION_KEY=
AI_API_ALLOWED_HOSTS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Cloudflare (optional; an API token, never the Account ID) ---------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- Demo manager ------------------------------------------------------------
DEMO_TICKET_SECRET=

# --- Test tooling only (tests/e2e, scripts) ----------------------------------
E2E_EMAIL=
E2E_PASSWORD=
ROLE_ACCOUNTS=
SEO_CRAWL_MAX=
