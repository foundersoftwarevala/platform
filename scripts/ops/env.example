# Operator credentials for scripts/ops/sv.sh
#
# Copy this to `.env.ops` in the repository root and fill it in. `.env.*` is
# already in .gitignore, so `.env.ops` is never committed and never reaches
# GitHub or Lovable. Nothing in scripts/ops/ has a credential written into it.
#
#   cp scripts/ops/env.example .env.ops
#
# Every one of these is a live production credential. If any of them has been
# pasted into a chat window, an issue, a screenshot or a support ticket, rotate
# it before filling this in.

# ---------------------------------------------------------------- the server
# The application host. sv.sh uses key-based authentication only: there is no
# password field here on purpose, because a password in a file is a password in
# a backup. Run `scripts/ops/bootstrap-ssh.sh` once to install a key.
SV_SSH_HOST=root@77.37.121.112
SV_SSH_KEY=~/.ssh/softwarevala_ops

# Where the application lives on that host, and the PM2 process that serves it.
SV_APP_DIR=/var/www/softwarevala
SV_PM2_NAME=softwarevala-staging

# --------------------------------------------------------------- the database
# Project reference from the Supabase dashboard URL.
SUPABASE_PROJECT_REF=nosnfgbcgeybwjgnwlzh
SUPABASE_URL=https://nosnfgbcgeybwjgnwlzh.supabase.co

# Personal access token (starts sbp_). Used ONLY for the Management API, which
# is what can run a migration. Create at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Service role / secret key (starts sb_secret_ or eyJ...). Used for PostgREST
# reads and RPC calls. This bypasses row level security - it is never sent to a
# browser and never committed.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ the CDN
# A real API token, NOT the Account ID. The value currently in circulation for
# this project is the Account ID pasted twice, which is why every Cloudflare
# call answers 6003 / 9106.
#
# Create at https://dash.cloudflare.com/profile/api-tokens with these scopes,
# all on the softwarevala.net zone only:
#   Zone / Cache Purge     / Purge
#   Zone / Zone Settings   / Edit
#   Zone / Cache Rules     / Edit
#   Zone / Zone            / Read
CF_API_TOKEN=
CF_ZONE_ID=cd39b15bbe9d0146a5750552c2043c16
CF_ACCOUNT_ID=fc311f40a3850a35f14e12b14fe7810a

# --------------------------------------------------------------- the repository
# Classic or fine-grained token with `repo` scope, for pushes and pull requests.
GITHUB_REPO=foundersoftwarevala/platform
GITHUB_TOKEN=

# ------------------------------------------------------------------ the site
SV_SITE=https://softwarevala.net
SV_ORIGIN_IP=77.37.121.112
